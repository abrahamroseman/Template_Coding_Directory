#!/bin/bash

# Directory containing this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Directory containing the notebooks
NOTEBOOK_DIR="${SCRIPT_DIR}/.."

# --- LIST YOUR NOTEBOOKS HERE ---
NOTEBOOKS=(
    "PythonFile1"
    "PythonFile2"
)

echo "Starting conversion of ${#NOTEBOOKS[@]} notebooks..."
echo "Notebook directory: ${NOTEBOOK_DIR}"
echo "Output directory:   ${SCRIPT_DIR}"
echo "--------------------------------------------"

for nb in "${NOTEBOOKS[@]}"; do
    INPUT_FILE="${NOTEBOOK_DIR}/${nb}.ipynb"

    if [ -f "$INPUT_FILE" ]; then
        echo "[PROCESSING] ${INPUT_FILE}..."

        jupyter nbconvert \
            --to script \
            "$INPUT_FILE" \
            --output-dir "$SCRIPT_DIR" \
            --log-level ERROR

        if [ $? -eq 0 ]; then
            echo "[SUCCESS] Created ${SCRIPT_DIR}/${nb}.py"
        else
            echo "[ERROR] Failed to convert ${nb}"
        fi
    else
        echo "[SKIPPED] ${INPUT_FILE} not found."
    fi
done

echo "--------------------------------------------"
echo "Done!"